{
  "name": "lucivo",
  "version": "0.16.3",
  "private": true,
  "description": "Lucivo Markdown Presenter - Exhibition-Grade Markdown Viewer",
  "license": "MIT",
  "scripts": {
    "pretest": "node tools/build-app.cjs --prod && node tools/build-app.cjs --prod --channel standalone",
    "test": "node tests/e2e.cjs",
    "test:unit": "node tests/document-model.test.cjs && node tests/structurizr-core.test.cjs && node tests/align-tables.test.cjs && node tests/analytics.test.cjs && node tests/resolve-affected-suites.test.cjs && node tests/build-color-tone-tables.test.cjs && node tests/url-loader.test.cjs && node tests/build-html-pages.test.cjs",
    "test:update-baseline": "node tools/update-visual-baseline.cjs",
    "build": "node tools/build-app.cjs",
    "build:prod": "node tools/build-app.cjs --prod",
    "build:standalone": "node tools/build-app.cjs --prod --channel standalone",
    "build:css": "node tools/build-tailwind-css.cjs",
    "build:vendor": "node tools/build-vendor.cjs",
    "build:samples": "node tools/build-samples-data.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "node tools/check-control-chars.cjs && node tools/check-modes.cjs && node tools/check-tones.cjs && eslint && npm run typecheck && npm run test:unit"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/m-plus-1-code": "5.3.1",
    "@fontsource-variable/noto-sans-jp": "5.3.1",
    "@fontsource-variable/noto-serif-jp": "5.3.1",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@fontsource/m-plus-rounded-1c": "5.3.0",
    "dompurify": "^3.4.18",
    "elkjs": "0.12.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "gemoji": "8.1.0",
    "katex": "0.19.1",
    "markdownlint": "^0.42.2",
    "marked": "^18.2.1",
    "mermaid": "12.3.0",
    "playwright": "1.65.1",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "minimatch": "11.0.5"
  }
}
